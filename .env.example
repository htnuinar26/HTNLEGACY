# Neon PostgreSQL pooled connection for the application.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Optional direct connection for Prisma migrations.
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Required authentication/encryption secrets.
JWT_SECRET="replace-with-a-long-random-secret"
ENCRYPTION_KEY="replace-with-64-hex-characters"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"

NEXT_PUBLIC_INSTANCE_NAME="HTN 26"
DEBUG_MW="0"

# Supabase Storage only. Keep secret keys server-side.
SUPABASE_URL="https://project-ref.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_replace-me"
SUPABASE_STORAGE_BUCKET="htnlegacy-receipts"
